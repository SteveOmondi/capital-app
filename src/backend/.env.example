# Application Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL Database (Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/capitalfm_db?schema=public

# Redis Cache & Rate Limiting
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Firebase Admin SDK (Push Notifications)
FIREBASE_PROJECT_ID=capital-fm-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@capital-fm-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# Webhook Security
WP_WEBHOOK_SECRET=capital_fm_secret_webhook_key_2026

# Upstream WordPress & Audio Services
WP_CMS_BASE_URL=https://www.capitalfm.africa/wp-json/wp/v2
PODCAST_RSS_URL=https://www.capitalfm.africa/feed/podcast/
LIVE_STREAM_PRIMARY_URL=https://atunwadigital.streamguys1.com/capitalfm
LIVE_STREAM_FALLBACK_URL=https://atunwadigital.streamguys1.com/capitalfm
ICY_STREAM_URL=https://atunwadigital.streamguys1.com/capitalfm

# StreamGuys Recast Audio Streaming API
STREAMGUYS_HOST=https://atunwadigital-recast.streamguys1.com
STREAMGUYS_CLIENT_ID=
STREAMGUYS_CLIENT_SECRET=
STREAMGUYS_PRIMARY_HLS_URL=https://atunwadigital.streamguys1.com/capitalfm
STREAMGUYS_FALLBACK_AAC_URL=https://atunwadigital.streamguys1.com/capitalfm
STREAMGUYS_ICY_STREAM_URL=https://atunwadigital.streamguys1.com/capitalfm

